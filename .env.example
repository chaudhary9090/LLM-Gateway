# LLM Gateway Environment Configuration Template

# Server & App
APP_NAME=LLM-Gateway
ENVIRONMENT=development
DEBUG=false
HOST=0.0.0.0
PORT=8000
GATEWAY_API_KEY=sk-gateway-secret-key-placeholder

# CORS Configuration (JSON array string)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://localhost:5173"]

# Redis Cache Settings
CACHE_ENABLED=true
REDIS_URL=redis://localhost:6379/0
CACHE_DEFAULT_TTL_SECONDS=3600
CACHE_LOCK_TIMEOUT_SECONDS=10.0
CACHE_SCHEMA_VERSION=v1

# Persistence (SQLite via async SQLAlchemy)
DATABASE_URL=sqlite+aiosqlite:///./gateway.db

# Resilience & Timeouts (Seconds)
REQUEST_OVERALL_TIMEOUT_SECONDS=30.0
PROVIDER_TIMEOUT_SECONDS=10.0
MAX_RETRIES=3
RETRY_MIN_WAIT_SECONDS=0.5
RETRY_MAX_WAIT_SECONDS=4.0
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT_SECONDS=30.0
CIRCUIT_BREAKER_HALF_OPEN_SUCCESSES=2

# Primary OpenAI-Compatible Provider
OPENAI_MAIN_ENABLED=false
OPENAI_MAIN_BASE_URL=https://api.openai.com/v1
OPENAI_MAIN_API_KEY=sk-proj-placeholder-main
OPENAI_MAIN_DEFAULT_MODEL=gpt-4o-mini
OPENAI_MAIN_TIMEOUT_SECONDS=15.0

# Secondary OpenAI-Compatible Provider (e.g., Groq, Together, DeepInfra, vLLM)
OPENAI_BACKUP_ENABLED=false
OPENAI_BACKUP_BASE_URL=https://api.groq.com/openai/v1
OPENAI_BACKUP_API_KEY=gsk-placeholder-backup
OPENAI_BACKUP_DEFAULT_MODEL=llama-3.1-8b-instant
OPENAI_BACKUP_TIMEOUT_SECONDS=15.0

# Deterministic Mock Providers (Local dev & CI testing)
MOCK_PRIMARY_ENABLED=true
MOCK_PRIMARY_LATENCY_MS=20
MOCK_PRIMARY_FAILURE_RATE=0.0

MOCK_SECONDARY_ENABLED=true
MOCK_SECONDARY_LATENCY_MS=30
MOCK_SECONDARY_FAILURE_RATE=0.0

# Offline Mode & Local Provider (Ollama / LM Studio / llama.cpp / vLLM)
OFFLINE_MODE=false
LOCAL_ENABLED=true
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_MODELS=llama3.2,mistral,qwen2.5,local-model
LOCAL_TIMEOUT_SECONDS=30.0
OLLAMA_AUTO_DISCOVER=true
